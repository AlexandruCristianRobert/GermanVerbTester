@model GermanVerbTester.Models.VerbManagementViewModel

@{
    ViewData["Title"] = "Manage Verbs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Verb Data Management</h2>
        <a asp-action="DownloadVerbsJson" class="btn btn-success">
            <i class="bi bi-download"></i> Download All Verbs (JSON)
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Section 1: Add Single Verb -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add Single Verb</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddSingleVerb" method="post">
                        <div class="mb-3">
                            <label asp-for="GermanVerb" class="form-label">German Verb (Infinitive)</label>
                            <input asp-for="GermanVerb" class="form-control" placeholder="e.g., gehen" />
                            <span asp-validation-for="GermanVerb" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EnglishVerb" class="form-label">English Translation</label>
                            <input asp-for="EnglishVerb" class="form-control" placeholder="e.g., to go" />
                            <span asp-validation-for="EnglishVerb" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select a category...</option>
                                <option value="A1">A1</option>
                                <option value="A2">A2</option>
                                <option value="B1">B1</option>
                                <option value="B2">B2</option>
                                <option value="C1">C1</option>
                                <option value="C2">C2</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Save Verb</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Section 2: Bulk JSON Upload -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Bulk JSON Upload</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Upload a JSON file containing an array of verb objects.</p>
                    <p class="text-muted small">Format must be:</p>
                    <pre class="bg-light p-2 small"><code>[
  {
    "german": "kommen",
    "english": "to come",
    "category": "A1"
  },
  {
    "german": "sehen",
    "english": "to see",
    "category": "A2"
  }
]</code></pre>

                    <form asp-action="UploadJsonVerbs" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="JsonFile" class="form-label"></label>
                            <input asp-for="JsonFile" type="file" class="form-control" accept=".json" required />
                        </div>
                        <button type="submit" class="btn btn-secondary w-100">Upload Verbs</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}