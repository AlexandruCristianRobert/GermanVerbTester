@{
    ViewData["Title"] = "German Verb Trainer";
}

<!-- Home View -->
<div id="homeView" class="view-container">
    <div class="text-center mt-5">
        <h1 class="display-4">German Verb Trainer</h1>
        <p class="lead">Configure your test settings below.</p>

        <div class="card mx-auto mt-4" style="max-width: 600px;">
            <div class="card-body">
                <div id="errorMessage" class="alert alert-danger d-none"></div>

                <!-- Number of Verbs -->
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Number of Verbs:</label>
                    <select id="numberOfVerbs" class="form-select">
                        <option value="5">5 Verbs</option>
                        <option value="10" selected>10 Verbs</option>
                        <option value="15">15 Verbs</option>
                        <option value="20">20 Verbs</option>
                        <option value="30">30 Verbs</option>
                        <option value="50">50 Verbs</option>
                    </select>
                </div>

                <!-- Category Selection -->
                <div class="form-group mb-4">
                    <label class="form-label fw-bold d-block">Select Categories:</label>
                    <div id="categoryContainer" class="row g-2">
                        <!-- Categories will be populated by JavaScript -->
                    </div>
                </div>

                <button id="startTestBtn" class="btn btn-primary w-100 btn-lg mt-3">Start Test</button>

                <div class="mt-3">
                    <button id="viewHistoryBtn" class="btn btn-outline-info btn-sm">View History</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Test View -->
<div id="testView" class="view-container d-none">
    <div class="container mt-4">
        <div id="testCompleted" class="alert alert-info text-center d-none">
            <h3 id="scoreDisplay"></h3>
            <button id="takeAnotherTestBtn" class="btn btn-primary btn-sm mt-2">Take Another Test</button>
            <button id="viewHistoryFromTestBtn" class="btn btn-secondary btn-sm mt-2">View History</button>
            <button id="backToHomeBtn" class="btn btn-outline-primary btn-sm mt-2">Back to Home</button>
        </div>

        <h2 id="testTitle" class="text-center">Translate the following:</h2>

        <form id="testForm" autocomplete="off">
            <div id="questionsContainer">
                <!-- Questions will be populated by JavaScript -->
            </div>

            <div id="submitButtonContainer" class="text-center mt-4 mb-5">
                <button type="submit" class="btn btn-success btn-lg px-5">Submit Answers</button>
            </div>
        </form>
    </div>
</div>

<!-- History View -->
<div id="historyView" class="view-container d-none">
    <div class="container mt-4">
        <h2>Past Test Results</h2>
        <button id="backToHomeFromHistoryBtn" class="btn btn-outline-primary mb-3">Back to Home</button>

        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Date / Time</th>
                    <th>Score</th>
                    <th>Percentage</th>
                </tr>
            </thead>
            <tbody id="historyTableBody">
                <!-- History will be populated by JavaScript -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/app.js" asp-append-version="true"></script>
}