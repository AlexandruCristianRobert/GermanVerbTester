@{
    ViewData["Title"] = "Configure Test";
}

<div class="text-center mt-5">
    <h1 class="display-4">German Verb Trainer</h1>
    <p class="lead">Select the number of verbs you want to practice.</p>

    <div class="card mx-auto mt-4" style="max-width: 400px;">
        <div class="card-body">
            <form asp-action="StartTest" method="post">
                <div class="form-group mb-3">
                    <label for="numberOfVerbs" class="form-label fw-bold">Number of Verbs:</label>
                    <select name="numberOfVerbs" class="form-select">
                        <option value="5">5 Verbs</option>
                        <option value="10">10 Verbs</option>
                        <option value="15">15 Verbs</option>
                        <option value="20">20 Verbs</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">Start Test</button>
            </form>
        </div>
    </div>
</div>