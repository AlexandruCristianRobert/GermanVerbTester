@model GermanVerbTester.Models.TestViewModel

<div class="container mt-4">
    @if (Model.IsCompleted)
    {
        <div class="alert alert-info text-center">
            <h3>You got @Model.Score / @Model.Questions.Count correct!</h3>
            <form asp-action="StartTest" method="post" class="d-inline">
                <input type="hidden" name="NumberOfVerbs" value="@Model.NumberOfVerbs" />
                @for (int j = 0; j < Model.SelectedCategories.Count; j++)
                {
                    <input type="hidden" name="SelectedCategories[@j]" value="@Model.SelectedCategories[j]" />
                }
                <button type="submit" class="btn btn-primary btn-sm mt-2">Take Another Test</button>
            </form>
            <a asp-action="History" class="btn btn-secondary btn-sm mt-2">View History</a>
        </div>
    }
    else
    {
        <h2 class="text-center">Translate the following:</h2>
    }

    <form asp-action="SubmitTest" method="post" autocomplete="off">
        <!-- Store configuration in hidden fields -->
        <input type="hidden" asp-for="NumberOfVerbs" />
        @for (int j = 0; j < Model.SelectedCategories.Count; j++)
        {
            <input type="hidden" name="SelectedCategories[@j]" value="@Model.SelectedCategories[j]" />
        }

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            // Hidden fields to ensure data persists on postback
            <input type="hidden" asp-for="Questions[i].VerbId" />
            <input type="hidden" asp-for="Questions[i].German" />
            <input type="hidden" asp-for="Questions[i].CorrectEnglish" />

            <div class="card mb-3">
                <div class="card-body @(Model.IsCompleted ? (Model.Questions[i].IsCorrect ? "bg-success bg-opacity-25" : "bg-danger bg-opacity-25") : "")">
                    <div class="row align-items-center g-3">
                        <div class="col-12 col-md-3 text-center text-md-start">
                            <h4 class="mb-0 verb-toggle"
                                data-german="@Model.Questions[i].German"
                                data-english="@Model.Questions[i].CorrectEnglish"
                                data-current="german"
                                style="cursor: pointer; user-select: none;">
                                @Model.Questions[i].German
                            </h4>
                        </div>
                        <div class="col-12 col-md-5">
                            @if (!Model.IsCompleted)
                            {
                                <input asp-for="Questions[i].UserAnswer"
                                       class="form-control"
                                       placeholder="English translation..."
                                       autocomplete="off"
                                       autocorrect="off"
                                       autocapitalize="off"
                                       spellcheck="false"
                                       required />
                            }
                            else
                            {
                                <input asp-for="Questions[i].UserAnswer" class="form-control" disabled />
                            }
                        </div>

                        @if (Model.IsCompleted)
                        {
                            <div class="col-12 col-md-4 text-center text-md-start">
                                @if (!Model.Questions[i].IsCorrect)
                                {
                                    <span class="fw-bold text-danger">Correct: @Model.Questions[i].CorrectEnglish</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-success">Correct!</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!Model.IsCompleted)
        {
            <div class="text-center mt-4 mb-5">
                <button type="submit" class="btn btn-success btn-lg px-5">Submit Answers</button>
            </div>
        }
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const verbToggles = document.querySelectorAll('.verb-toggle');

            verbToggles.forEach(function(element) {
                element.addEventListener('dblclick', function() {
                    const german = this.getAttribute('data-german');
                    const english = this.getAttribute('data-english');
                    const current = this.getAttribute('data-current');

                    if (current === 'german') {
                        this.textContent = english;
                        this.setAttribute('data-current', 'english');
                    } else {
                        this.textContent = german;
                        this.setAttribute('data-current', 'german');
                    }
                });
            });
        });
    </script>
}